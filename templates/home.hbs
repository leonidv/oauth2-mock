{{#*inline "style"}}
{{/inline}}
{{#*inline "script"}}
{{/inline}}

{{#*inline "page"}}
        <h2>Users from the configuration</h2>

        <table class="users-table">
            <thead>
                <th>Login</th>
                <th>Description</th>
            </thead>
            <tbody>
                {{#each users}}
                <tr>
                    <td>{{login}}</td>
                    <td>{{description}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <h2>Mocked provider: {{provider_name}}</h2>

        <div class="endpoint">
            <h3>Authorization Endpoint</h3>
            <p><code>GET {{authorization_path}}</code></p>
            <p>Set this endpoint as authorization URI</p>
            <p>Display all registered users with links to authorize</p>
        </div>

        <div class="endpoint">
            <h3>Token Endpoint</h3>
            <p><code>POST {{token_path}}</code></p>
            <p>Set this endpoint as token URI</p>
            <p>Parameters: grant_type, code, redirect_uri, client_id, client_secret,
                code_verifier, refresh_token</p>
        </div>

        <div class="endpoint">
            <h3>User Info Endpoint</h3>
            <p><code>GET {{userinfo_path}}</code></p>
            <p>Headers: Authorization: {{authorization_header_prefix}} &lt;access_token&gt;</p>
            <p>You can configure header's value prefix. See the application's
                configuration</p>
        </div>

{{/inline}}
{{> base}}
