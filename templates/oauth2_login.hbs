{{/inline}}

{{#*inline "script"}}
function changeState() {
const newStateValue = document.getElementById('state').value;
const url = new URL(window.location.href);
const currentState = url.searchParams.get('state');

if (currentState) {
url.searchParams.set('state', newStateValue);
url.searchParams.set('previous_state', currentState);
} else {
url.searchParams.set('state', newStateValue);
}

window.location.href = url.toString();
}

let currentHint = null;

function showHint(error) {
if (currentHint) return; // Prevent multiple hints

let message = '';
switch(error) {
case 'invalid_request':
message = 'The request is missing a required parameter, includes an invalid parameter value, or is otherwise
malformed.';
break;
case 'unauthorized_client':
message = 'The client is not authorized to request an authorization code using this method.';
break;
case 'access_denied':
message = 'The resource owner or authorization server denied the request.';
break;
case 'unsupported_response_type':
message = 'The authorization server does not support obtaining an authorization code using this method.';
break;
case 'invalid_scope':
message = 'The requested scope is invalid, unknown, or malformed.';
break;
case 'server_error':
message = 'The authorization server encountered an unexpected condition that prevented it from fulfilling the request.';
break;
case 'temporarily_unavailable':
message = 'The authorization server is currently unable to handle the request due to a temporary overloading or
maintenance of the server.';
break;
default:
message = 'Unknown error.';
}

// Create and show hint element
const hint = document.createElement('div');
hint.id = 'error-hint';
hint.textContent = message;

// Position the hint near the cursor
document.addEventListener('mousemove', updateHintPosition);

document.body.appendChild(hint);

// Trigger reflow to ensure transition works
void hint.offsetWidth;
hint.classList.add('show');

currentHint = hint;
}

function updateHintPosition(e) {
if (currentHint) {
currentHint.style.left = (e.pageX + 10) + 'px';
currentHint.style.top = (e.pageY + 10) + 'px';
}
}

function hideHint() {
if (currentHint) {
currentHint.classList.remove('show');
// Wait for transition to complete before removing
if (currentHint) {
document.body.removeChild(currentHint);
currentHint = null;
}

document.removeEventListener('mousemove', updateHintPosition);
}
}
{{/inline}}

{{#*inline "page"}}
<div class="oauth2-container">
    <div class="oauth2-container-panel users-panel">
        <h2>Login as User</h2>
        <section>
            <ul class="users-list">
                {{#each users}}
                <li>
                    <a href="/authorize?login={{login}}&{{../auth_params}}">{{login}} - {{description}}</a>
                </li>
                {{/each}}
            </ul>
        </section>
        <div>After an authorization you will be redirected to: <span class="monospace">{{redirect_uri}}</span></div>
    </div>
    <div class="oauth2-container-panel">
        <h2>Non-positive Cases</h2>
        <h3>Errors</h3>
        <section>
            <ul class="error-links">
                <li><span class="hint" onmouseover="showHint('invalid_request')" onmouseout="hideHint()">ℹ️</span> <a
                        href="/error?error=invalid_request">invalid_request</a></li>
                <li><span class="hint" onmouseover="showHint('unauthorized_client')" onmouseout="hideHint()">ℹ️</span>
                    <a href="/error?error=unauthorized_client">unauthorized_client</a>
                </li>
                <li><span class="hint" onmouseover="showHint('access_denied')" onmouseout="hideHint()"> ℹ️</span> <a
                        href="/error?error=access_denied">access_denied</a></li>
                <li><span class="hint" onmouseover="showHint('unsupported_response_type')"
                        onmouseout="hideHint()">ℹ️</span> <a
                        href="/error?error=unsupported_response_type">unsupported_response_type</a></li>
                <li><span class="hint" onmouseover="showHint('invalid_scope')" onmouseout="hideHint()">ℹ️</span> <a
                        href="/error?error=invalid_scope">invalid_scope</a></li>
                <li><span class="hint" onmouseover="showHint('server_error')" onmouseout="hideHint()">ℹ️</span> <a
                        href="/error?error=server_error">server_error</a></li>
                <li><span class="hint" onmouseover="showHint('temporarily_unavailable')"
                        onmouseout="hideHint()">ℹ️</span> <a
                        href="/error?error=temporarily_unavailable">temporarily_unavailable</a></li>
            </ul>
        </section>
        <h3>Change state</h3>
        <section>
            <input id="state" class="input-state" type="text" value="{{state}}"> <button onclick="changeState()">Change</button>
            {{#if state_changed }}<p>Previous state: <span class="monospace" style="word-wrap: anywhere;">{{
                    previous_state }}</span> </p> {{/if}}
        </section>
    </div>
</div>
{{/inline}}
{{> base}}